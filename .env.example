# Server config
PORT=4000
# Local default; Coolify/Dockerfile sets HOST=0.0.0.0
HOST=127.0.0.1

# Authentication (required when HOST is not localhost)
AUTH_PASSWORD=
AUTH_USER=monitor

# Database path (Coolify: /app/data/monitor.db with persistent volume at /app/data)
DB_PATH=./monitor.db

# Google Maps Platform — Geocoding API (optional)
# Leave blank to keep the app running exactly as before (country-centroid
# placement only). Set this to enable precise place-level geocoding of
# RSS/DOC headline mentions (e.g. "Goma" resolves to Goma itself, not
# DR Congo's capital). Get a key at https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# Self-imposed daily cap on Geocoding API calls (safety valve against
# runaway cost; results are cached forever so this budget is really only
# spent on genuinely new place names).
GEOCODE_DAILY_BUDGET=2500

# Classifier rollout. Rules are the only default production path.
CLASSIFIER_MODE=rules
MODEL_PATH=
MODEL_PROMOTION_PATH=

# Korean issue monitor
YOUTUBE_API_KEY=
YOUTUBE_DAILY_BUDGET=1000
# Comma-separated search topics; defaults to 한국,서울,부산,재난,경제; use off to disable
KOREAN_WATCH_QUERIES=
